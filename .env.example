# Copy to .env and replace every value. Generate secrets with:  openssl rand -hex 32
# .env is git-ignored. Never commit real values.

# Postgres (shared by Chatwoot, n8n and Odoo)
POSTGRES_PASSWORD=change-me-postgres
N8N_DB_PASSWORD=change-me-n8n-db
ODOO_DB_PASSWORD=change-me-odoo-db

# Redis (Chatwoot)
REDIS_PASSWORD=change-me-redis

# Chatwoot
CHATWOOT_SECRET_KEY_BASE=change-me-long-random-string
CHATWOOT_FRONTEND_URL=http://localhost:3000

# n8n
N8N_ENCRYPTION_KEY=change-me-long-random-string
N8N_WEBHOOK_URL=http://localhost:5678/

# Optional image pins
CHATWOOT_VERSION=v4.18.0
N8N_VERSION=2.42.6
ODOO_VERSION=19.0
TZ=UTC

# API keys for the LLM, Odoo and Chatwoot are NOT set here.
# They are stored as n8n credentials (encrypted with N8N_ENCRYPTION_KEY); see README step 6.
